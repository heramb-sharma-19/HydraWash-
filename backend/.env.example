# Copy this file to ".env" and fill in your values. NEVER commit .env
PORT=3000
NODE_ENV=development

# --- MySQL (same values you use in MySQL Workbench) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hydrawash_user
DB_PASSWORD=ChangeMe_123!
DB_NAME=hydrawash_db

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS: comma separated list of frontends allowed to call the API ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# service_id used when the app does not send one (1 = Wash)
DEFAULT_SERVICE_ID=1
